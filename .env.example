# Maeve'mom environment template
# Copy this file to .env locally, then replace placeholders.
# Never commit .env or paste secret values into frontend code.

# Supabase project
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_key
# Server-only; never expose this in frontend code.
SUPABASE_SECRET_KEY=your_supabase_secret_key_server_only

# Keep OFF until the profile repository is enabled and Memory Lane is verified locally.
USE_SUPABASE_MEMORY_REPOSITORY=false

# Public URL used for email verification and password-reset redirects
APP_URL=https://your-render-app.onrender.com

# Existing app/session settings (JWT remains until Supabase Auth migration)
JWT_SECRET=replace_with_a_long_random_secret
PORT=3000

# Optional persistent storage settings for local/Render disk deployments
STORAGE_DIR=/var/data
MEDIA_DIR=/var/data/uploads
DATA_DIR=/var/data
MEDIA_BUDGET_BYTES=12884901888
MAX_UPLOAD_BYTES=21474836480
FFMPEG_PATH=ffmpeg
